# CalTrack Environment Variables
# Copy this to .env and fill in your values

# SQLiteCloud Database Connection
# Format: sqlitecloud://host:port/database?apikey=YOUR_API_KEY
# Example: sqlitecloud://csiy8chrdz.g4.sqlite.cloud:8860/auth.sqlitecloud?apikey=vSNtHsYqdWD1zIUuMrACgpw0LwePjDL2MLGzESZiYyY
DATABASE_URL=sqlitecloud://YOUR_HOST:8860/YOUR_DATABASE?apikey=YOUR_API_KEY

# USDA API Key (optional, for HK food data)
USDA_API_KEY=your_usda_api_key_here

# Server Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (for frontend development)
FRONTEND_URL=http://localhost:5173
